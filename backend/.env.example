# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# ── Database (PostgreSQL) ─────────────────────────────────
# PostgreSQL must be running. Example local connection:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clrms
DB_POOL_MAX=10
DB_QUERY_LOG=false

# ── JWT ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-minimum
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-minimum
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ── Security ──────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15
CORS_ORIGINS=http://localhost:5173

# ── Email (Nodemailer) ────────────────────────────────────
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_SECURE=false
MAIL_FROM="CLRMS <no-reply@clrms.local>"

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=info

# Enable for dev QR generation
QR_SECRET=qr-signing-secret